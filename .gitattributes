# Line endings are pinned here so they do not depend on each contributor's
# core.autocrlf setting. Everything is stored as LF in the repository (which is
# already true of every file in the index, so adding this file renormalises
# nothing and produces no diff).

* text=auto eol=lf

# Windows shells are happier with CRLF, and nothing else reads these.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Never touch these.
*.wav binary
*.raw binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.sys binary
*.pdb binary
*.zip binary
