# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
prototype/.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

README-human.md

# Claude Code agent worktrees
.claude/worktrees/

# Diagnostic one-offs (mouse_probe.py and friends)
scratchpad/

# Build output
build/
dist/
target/

# Dashboard UI (app/dashboard-ui): deps only -- the built page,
# app/ds5app/dashboard.html, IS committed (the tray serves it as-is).
node_modules/

# Editors
.vscode/
.idea/

# Test signals and captures. `samples/*.wav` is deliberately not committed:
# regenerate it with `python -m ds5bridge gen-wav ../samples/test-sweep.wav`,
# which is deterministic, so nothing is lost.
*.wav
*.raw
*.log

# Emulator run artefacts
stats*.json
ds5*_stats.json

# Bundle installer: pinned vendor installers are downloaded at build time
app/packaging/bundle/vendor/
